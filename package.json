{
  "name": "@labica/flora",
  "version": "0.1.0",
  "description": "Adaptive floral ornament generator: procedural flowers, growth into any region, many materials. Zero runtime dependencies.",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "default": "./dist/element.js"
    }
  },
  "files": [
    "dist",
    "NOTICE.md"
  ],
  "sideEffects": [
    "./dist/element.js",
    "./src/element.ts"
  ],
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test \"tests/**/*.test.ts\"",
    "demo": "node scripts/build-demo.mjs",
    "size": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/size.ts",
    "gallery": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/gallery.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "0.25.0",
    "typescript": "5.8.2"
  }
}
